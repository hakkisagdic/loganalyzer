<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Bizigo.Contracts\Bizigo.Contracts.csproj" />
    <!-- Yön: ingest → arşiv. Arşiv katmanı WAL'ın biçimini bilmez. -->
    <ProjectReference Include="..\Bizigo.Storage.Raw\Bizigo.Storage.Raw.csproj" />
    <ProjectReference Include="..\Bizigo.Parsing\Bizigo.Parsing.csproj" />
    <ProjectReference Include="..\Bizigo.ControlPlane\Bizigo.ControlPlane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    OTLP mesaj sınıfları opentelemetry-proto v1.9.0'dan üretilir (F1 §2.1).
    GrpcServices="None": yalnızca mesajlar; :4317 gRPC ucu v1'de yok (kaçış kapısı).
    Üretilen kod repoya girmez — proto dosyaları tek kaynak.
  -->
  <ItemGroup>
    <Protobuf Include="Otlp\proto\**\*.proto"
              ProtoRoot="Otlp\proto"
              GrpcServices="None"
              Access="Internal" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Üretilen protobuf kodu bizim analiz kurallarımıza uymuyor; kendi kodumuzda kural aynen geçerli. -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

</Project>
