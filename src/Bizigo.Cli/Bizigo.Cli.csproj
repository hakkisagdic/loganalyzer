<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Bizigo.Query\Bizigo.Query.csproj" />
    <ProjectReference Include="..\Bizigo.Ingest\Bizigo.Ingest.csproj" />
    <ProjectReference Include="..\Bizigo.Parsing\Bizigo.Parsing.csproj" />
    <ProjectReference Include="..\Bizigo.Alerting\Bizigo.Alerting.csproj" />
    <ProjectReference Include="..\Bizigo.Mcp\Bizigo.Mcp.csproj" />

    <!--
      stdio yüzeyi de aynı araçları ilan etmeli. Bu satır olmadan
      `bizigo mcp serve` ürün yüzeyinde SIFIR araç ilan ederdi ve arıza
      hiçbir yerde hata vermezdi: keşif referans kapanışını yürüyor, ulaşamadığı
      derlemeyi atlıyor, ve boş bir küme de geçerli bir küme.
    -->
    <ProjectReference Include="..\Bizigo.Mcp.Product\Bizigo.Mcp.Product.csproj" />

    <!--
      M02 — komut çekirdeği. CLI artık bir SUNUM katmanı: iş çekirdekte,
      burada yalnızca konsola çizim ve çıkış kodu.
    -->
    <ProjectReference Include="..\Bizigo.Commands\Bizigo.Commands.csproj" />

    <!--
      Komut çekirdeğinin MCP SUNUMU. Referans ZORUNLU ve keşif mekaniği
      yüzünden: `McpToolDiscovery.ProductAssemblies` kompozisyon kökünden
      (bu derleme) başlayıp `Bizigo.*` referanslarını geziyor. Buradan
      referans verilmezse araçlar YÜKLENMİYOR ve uyum kapısı sıfır araç
      görüp sessizce yeşil yanıyor.
    -->
    <ProjectReference Include="..\Bizigo.Commands.Mcp\Bizigo.Commands.Mcp.csproj" />
    <ProjectReference Include="..\..\sim\Bizigo.Simulators\Bizigo.Simulators.csproj" />
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />

    <!--
      M13 — stdio kimliği. `AddJwtBearer` KULLANILAMIYOR: ASP.NET paylaşılan
      çatısı bu projeye inince üst-düzey ifadelerin ürettiği `Program` görünür
      hâle geliyor ve `Bizigo.Api`'nin `Program`'ıyla çakışıyor (ölçüldü,
      gerekçe `Bizigo.Mcp.csproj`'da). Bu iki paket ASP.NET taşımıyor ve
      API'nin belirteci doğruladığı kütüphanenin AYNI sürümü (8.19.2).
    -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bizigo</AssemblyName>
    <RootNamespace>Bizigo.Cli</RootNamespace>
  </PropertyGroup>

</Project>
