<Project>
  <!--
    Lite bağımsız bir uygulama: kök Directory.Build.props'u BİLEREK devralmıyor
    (kendi imajı, kendi SDK sabitlemesi var). Hedef çatı .NET 10 LTS — net8
    desteği 2026-11-10'da bitiyor.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Uyarı = hata: Lite artık sıfır uyarıyla derleniyor, kapı açık kalsın. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
