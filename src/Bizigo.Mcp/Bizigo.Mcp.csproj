<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MCP protokol çekirdeği (M01). Çekirdek protokolü konuşuyor, ürünü tanımıyor;
    araçlar (M03/M04/M05) kendi katmanlarında doğuyor ve buradaki
    `BizigoMcpTool`'dan türüyor.

    M01'de ürün projelerine HİÇ referans yoktu. M06 bir tane ekledi
    (`Bizigo.Contracts`) ve gerekçesi aşağıda: iki KAPI bu projeye girmek
    zorundaydı. Sayının bir kalmasının sebebi var — bkz. `Bizigo.Rca`nın
    elenmesi.

    ASP.NET Core BİLEREK YOK — ve gerekçesi ölçüldü.

    İlk hâli `FrameworkReference Microsoft.AspNetCore.App` taşıyordu, çünkü
    akışlanabilir HTTP taşıması onu istiyor. Sonuç: `Bizigo.Cli` (stdio için bu
    projeye referans veriyor) ASP.NET paylaşılan çatısına sürükleniyor ve
    üst-düzey ifadelerinin ürettiği `Program` sınıfı GÖRÜNÜR hâle geliyor —
    `Bizigo.Api`'nin `public partial class Program`'ı ile çakışıyor ve birim
    test paketi BEŞ ayrı yerde CS0433 ile düşüyor.

    Hata mesajı ("`Program` hem `Bizigo.Api` hem `bizigo` içinde") kusurun
    kendisini gizliyordu; bulunuşu iki adımlık bir ölçümle oldu (önce
    `InternalsVisibleTo` elendi, sonra `Bizigo.Cli` -> `Bizigo.Mcp` referansı
    kaldırılınca hata sıfıra düştü). Ama derleme hatası yalnızca BELİRTİ:
    asıl kusur bir konsol aracının bir web çatısını taşıması.

    Ayrım şimdi şurada: HTTP taşıması `Bizigo.Api`'nin işi — ASP.NET zaten
    orada. Bu proje protokolü ve stdio'yu konuşuyor.
  -->

  <ItemGroup>
    <!--
      M06 — TEK ürün referansı, ve tek olması ölçülerek seçildi.

      İki kapı bu projeye girmek zorundaydı: T41'in `RedactedPrompt`'u (log
      metninin taşıyıcısına parametre tipi olarak) ve K6'nın ağ sınırı ekseni
      (`DataBoundary`). İkisi de `Bizigo.Contracts`'ta ve BU PROJENİN HİÇ
      ProjectReference'ı YOK — yaprak. Yani buraya bağlanmanın geçişli maliyeti
      sıfır.

      `DataBoundary`'nin ilk yeri `Bizigo.Rca.Models` idi ve oradan kullanmak
      ELENDİ: `Bizigo.Rca` ControlPlane, ScenarioPlugin ve
      `Microsoft.Extensions.Http` taşıyor, ve stdio için buraya referans veren
      `Bizigo.Cli` hepsini yutardı. Bu, aşağıdaki ASP.NET yorumunun ölçtüğü
      kusurun aynısı — bir konsol aracının taşımak zorunda olmadığı bir yığını
      taşıması. Tip bu yüzden `Bizigo.Contracts`'a TAŞINDI, kopyalanmadı
      (CLAUDE.md §9).
    -->
    <ProjectReference Include="..\Bizigo.Contracts\Bizigo.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Uyum kapısı `McpLogText`'in menteşesini sınıyor: bugün ürün tarafında
      çağıranı olmayan `internal` fabrika. Kapı onu göremezse menteşenin
      çalıştığını kimse ölçemez ve M06 boş bir yere takılır.
    -->
    <InternalsVisibleTo Include="Bizigo.UnitTests" />
  </ItemGroup>

</Project>
