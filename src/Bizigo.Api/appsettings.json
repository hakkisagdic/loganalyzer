{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ControlPlane": "Host=localhost;Port=5432;Database=bizigo;Username=bizigo;Password=bizigo",
    "ClickHouse": "Host=localhost;Port=8123;Database=bizigo;Username=bizigo;Password=bizigo"
  },
  "ClickHouse": {
    "MigrationsDirectory": "db/clickhouse"
  },
  "RawStore": {
    "ServiceUrl": "http://localhost:9000",
    "Bucket": "bizigo-raw",
    "AccessKey": "bizigoadmin",
    "SecretKey": "bizigoadmin",
    "ForcePathStyle": true,
    "TargetObjectBytes": 67108864,
    "CompressionLevel": 3,
    "SegmentRetention": "48:00:00",
    "ScrubInterval": "06:00:00",
    "ScrubSampleSize": 20
  },
  "Ingest": {
    "ChannelCapacity": 1024,
    "WorkerCount": 0,
    "MaxRequestBytes": 16777216,
    "DefaultFallbackEncoding": "windows-1254",
    "Wal": {
      "Directory": "/var/lib/bizigo/wal",
      "MaxSegmentBytes": 134217728,
      "MaxTotalBytes": 8589934592,
      "RetryAfterSeconds": 5,
      "FlushToDisk": true
    }
  }
}
