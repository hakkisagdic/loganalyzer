{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ControlPlane": "Host=localhost;Port=5432;Database=bizigo;Username=bizigo;Password=bizigo",
    "ClickHouse": "Host=localhost;Port=8123;Database=bizigo;Username=bizigo;Password=bizigo"
  },
  "ClickHouse": {
    "MigrationsDirectory": "db/clickhouse"
  },
  "Ingest": {
    "ChannelCapacity": 1024,
    "WorkerCount": 0,
    "MaxRequestBytes": 16777216,
    "DefaultFallbackEncoding": "windows-1254",
    "Wal": {
      "Directory": "/var/lib/bizigo/wal",
      "MaxSegmentBytes": 134217728,
      "MaxTotalBytes": 8589934592,
      "RetryAfterSeconds": 5,
      "FlushToDisk": true
    }
  }
}
