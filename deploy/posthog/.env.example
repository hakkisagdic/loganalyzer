# cp .env.example .env — .env commitlenmez (bkz. kök .gitignore: /deploy/.env)
#
# PostHog hobby yığınının ortam değişkenleri. Yığının kendisi
# `fetch-compose.sh` ile sabitlenmiş bir commit'ten iniyor.

# Dışarıdan görünen adres. PostHog bunu e-posta bağlantılarında ve CSRF
# kontrolünde kullanıyor; yanlışsa giriş çalışıyor ama davet bağlantıları
# yanlış hosta gidiyor.
SITE_URL=http://posthog.ic.local:8000

# Django gizli anahtarı. Değişirse BÜTÜN oturumlar ve API anahtarları düşer.
#   openssl rand -hex 32
SECRET_KEY=

# Postgres. Üretimde bu konteyner DIŞINA alınmalı — hobby yığınında veri
# konteyner hacminde ve `docker compose down -v` onu siliyor.
POSTHOG_POSTGRES_HOST=db
POSTHOG_DB_NAME=posthog
POSTHOG_DB_USER=posthog
POSTHOG_DB_PASSWORD=

# ClickHouse — olayların yaşadığı yer. Bizigo'nun KENDİ ClickHouse'uyla
# (`deploy/docker-compose.yml`) aynı örnek DEĞİL ve olmamalı: ürünün ingest
# yükü ile analitiğin sorgu yükü aynı düğümde birbirini bekletir.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DATABASE=posthog

# E-posta (davet ve parola sıfırlama). Boş bırakılırsa kullanıcı davet
# edilemez, yalnızca ilk yönetici hesabı kurulur.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_DEFAULT_FROM=posthog@ic.local

# Ürün içi telemetri: PostHog'un KENDİSİNİN PostHog'a rapor göndermesi.
# Kapalı — kendi kurulumumuzun kullanım verisinin dışarı gitmesinin sebebi yok.
DISABLE_SECURE_SSL_REDIRECT=true
POSTHOG_DISABLE_TELEMETRY=true
