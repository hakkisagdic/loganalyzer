# cp .env.example .env — .env commitlenmez (.gitignore)

PG_USER=loganalyzer
PG_PASSWORD=loganalyzer
PG_PORT=5432

CH_USER=loganalyzer
CH_PASSWORD=loganalyzer
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9010

S3_ACCESS_KEY=loganalyzeradmin
S3_SECRET_KEY=loganalyzeradmin
S3_PORT=9000
S3_CONSOLE_PORT=9001

KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
KC_PORT=8180

SYSLOG_TCP_PORT=5140
SYSLOG_UDP_PORT=5141
OTLP_HTTP_PORT=4318
# Collector'ın KENDİ metrikleri — varış defterinin (B02) ikinci katmanı buradan
# okunuyor. Yalnızca geliştirme yığını için: üretimde uç kapalı ya da yalnızca
# kazıyıcının gördüğü bir ağda olmalı.
OTEL_METRICS_PORT=8888
SIDECAR_PORT=8099

# OTel Collector'ın .NET ingest servisine ulaşacağı adres
LOGANALYZER_ENDPOINT=http://host.docker.internal:5080

# Oturum deposu (B7) — `redis-session` servisinin dışarı açtığı port.
# Yalnızca BFF_SESSION_STORE=redis iken gerekiyor.
#
# Sidecar'ın `redis`'i AYRI bir servis ve dışarı port açmıyor; ikisinin ayrı
# olma sebebi docker-compose.yml'de `redis-session`'ın yorumunda yazılı.
REDIS_PORT=6379
