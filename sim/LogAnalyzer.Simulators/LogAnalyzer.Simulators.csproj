<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cihaz simülatörleri (FS · S01).

    `src/` ALTINDA DEĞİL ve bu bilinçli: burası ürün değil, ürünün cihaza
    dokunan yüzeyini gerçek cihaz olmadan sınamak için var. `src/` altına
    konulsaydı "hangi derleme üretime gidiyor" sorusunun cevabı bulanıklaşırdı.
    `sidecar/` ile aynı seviyede duruyor — o da ayrı bir bileşen.

    `LogAnalyzer.Devices`'a referans veriyor çünkü N1 seviyesi `IDeviceTransport`'u
    uyguluyor ve toplayıcıların komut listesini okuyor. Referans TEK YÖNLÜ:
    ürün burayı hiç görmüyor.
  -->

  <PropertyGroup>
    <!--
      Hem kütüphane hem çalıştırılabilir. N1 sahte taşıyıcısı birim
      testlerinden referansla kullanılıyor; syslog basıcısı `dotnet run` ile
      koşuyor. İkiye bölmek profil okuyucusunun iki yerden referanslanması
      demekti ve §9'un yasakladığı ikinci kopyaya davetiye çıkarırdı.
    -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LogAnalyzer.Devices\LogAnalyzer.Devices.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Capacity\LogAnalyzer.Capacity.csproj" />

    <!--
      `SampleTimeRewriter` için. Basıcı örnek satırın zaman damgasını şimdiye
      kaydırmak zorunda (S02a) ve o kaydırıcı ZATEN VAR — `GoldenSampleSeeder`
      kullanıyor. İkinci bir kopya yazmak yerine ortak eve taşındı
      (`LogAnalyzer.Cli.Seeding` → `LogAnalyzer.Parsing.Samples`), çünkü `LogAnalyzer.Parsing`
      ikisinin de görebildiği en dar ortak nokta.
    -->
    <ProjectReference Include="..\..\src\LogAnalyzer.Parsing\LogAnalyzer.Parsing.csproj" />

    <!--
      M03 · `loganalyzer-sim` MCP araçları burada yaşıyor (`Mcp/`).

      YÖN ÖNEMLİ VE TERS DEĞİL: simülatör MCP çekirdeğini görüyor, çekirdek
      simülatörü görmüyor. `LogAnalyzer.Mcp` protokolü konuşuyor ve kim araç
      yazdığını bilmiyor; araçlar kendi katmanlarında oturuyor. Tersi —
      çekirdeğin simülatöre referans vermesi — `LogAnalyzer.Api`'yi de simülatöre
      bağlardı, oysa yukarıdaki yorumun "ürün burayı hiç görmüyor" cümlesi
      tam olarak onu yasaklıyor.

      Araçların İLAN EDİLMESİ bu referansa değil `SimulatorMcpSetup`'a bağlı;
      gerekçesi (derleyicinin dokunulmayan referansı budaması) orada yazılı.
    -->
    <ProjectReference Include="..\..\src\LogAnalyzer.Mcp\LogAnalyzer.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
