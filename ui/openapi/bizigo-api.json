  "components": {
    "schemas": {
      "AlertRuleRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ruleType": {
            "type": "string"
          },
          "ownerGroups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fullText": {
            "type": [
              "null",
              "string"
            ]
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldFilterRequest"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "windowSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "intervalSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "threshold": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "comparison": {
            "type": "string"
          },
          "silenceSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "repeatIntervalSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "enabled": {
            "type": "boolean"
          },
          "channelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "AuthMeResponse": {
        "required": [
          "subject",
          "username",
          "roles",
          "idp_groups",
          "owner_groups",
          "unrestricted",
          "sees_nothing"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "idp_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unrestricted": {
            "type": "boolean"
          },
          "sees_nothing": {
            "type": "boolean"
          }
        }
      },
      "ChangeWriteRequest": {
        "required": [
          "ownerGroup",
          "targetKind",
          "targetId",
          "changeKind"
        ],
        "type": "object",
        "properties": {
          "ownerGroup": {
            "type": "string"
          },
          "targetKind": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "changeKind": {
            "type": "string"
          },
          "timestamp": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "externalRef": {
            "type": "string"
          }
        }
      },
      "EventSearchRequest": {
        "type": "object",
        "properties": {
          "from": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "to": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "fullText": {
            "type": [
              "null",
              "string"
            ]
          },
          "filters": {
