# cp .env.example .env.local — .env.local commitlenmez
#
# Hepsi SUNUCU tarafı. Hiçbiri `NEXT_PUBLIC_` önekli değil, dolayısıyla hiçbiri
# tarayıcı paketine girmiyor. Buraya bir `NEXT_PUBLIC_KEYCLOAK_CLIENT_SECRET`
# eklemek gizli anahtarı doğrudan tarayıcıya vermek olurdu.

# Keycloak realm adresi. `Bizigo.Api`'nin `Auth:Authority` değeriyle AYNI olmak
# zorunda; ayrışırsa API her token'ı issuer uyuşmazlığından reddeder
# (bkz. deploy/keycloak/README.md — KC_HOSTNAME).
KEYCLOAK_ISSUER=http://localhost:8180/realms/bizigo
KEYCLOAK_CLIENT_ID=bizigo-ui

# Realm dosyasındaki geliştirme değeri. Üretimde gizli yöneticiden gelir.
KEYCLOAK_CLIENT_SECRET=bizigo-ui-dev-secret

# Next uygulamasının dışarıdan görünen kökü. Dönüş adresi buradan türüyor ve
# realm'deki `redirectUris` ile birebir eşleşmeli: <BFF_PUBLIC_URL>/signin-oidc
BFF_PUBLIC_URL=http://localhost:3000

# `Bizigo.Api`. Tarayıcı buraya HİÇ konuşmuyor — yalnızca Next sunucusu.
BIZIGO_API_URL=http://localhost:5080

# Oturum çerezinin adı ve sunucudaki ömrü (saniye).
BFF_COOKIE_NAME=bizigo.sid
BFF_SESSION_TTL_SECONDS=28800

# Oturum deposu: `memory` (tek süreç, geliştirme) ya da `redis` (çok kopya).
#
# Bellek içi hâl varsayılan ve bilinçli: Redis zorunlu olsaydı yerel ortam tek
# komutla ayağa kalkmazdı. Ama TEK SÜREÇTE geçerli — ikinci bir kopya
# açıldığında oturumlar kopyalar arasında paylaşılmaz ve kullanıcılar rastgele
# düşmeye başlar. Çok kopyaya çıkarken `redis` şart.
#
# `redis` seçilip `BFF_REDIS_URL` verilmezse uygulama AÇILMIYOR: sessizce
# belleğe düşmek, tek kopyalık bir depoyla çalıştığını fark etmemek demek.
BFF_SESSION_STORE=memory
# BFF_REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Telemetri (PostHog) — bkz. deploy/posthog/README.md
#
# HEPSİ VARSAYILAN KAPALI. Bu ürün müşterinin log'unu okuyor; kurulumun
# kendiliğinden dışarı konuşmaya başlaması, ürünü değerlendiren bir güvenlik
# ekibinin ilk gün bulacağı şey olurdu. Açmak bilinçli bir hareket.
#
# Buradaki hiçbir değişken `NEXT_PUBLIC_` önekli DEĞİL — proje anahtarı bile.
# Anahtar sunucu bileşeninde okunup istemciye prop olarak geçiyor; böylece
# `next.config.ts`'in bilinçli olarak boş bıraktığı `env` girdisi açılmıyor.

# Yalnızca "true"/"1"/"on"/"yes" açıyor. Yazım hatası taşıyan bir değer
# telemetriyi KAPATIR — yanlış yönde hata yapmamak için.
TELEMETRY_ENABLED=false

# PostHog proje (yazma) anahtarı — `phc_…`. Sır değil ama yine de sunucudan
# geçiyor.
# TELEMETRY_PROJECT_KEY=phc_xxx

# Olayların gittiği PostHog adresi. TARAYICI BURAYA HİÇ KONUŞMUYOR; yalnızca
# Next sunucusu (`/api/telemetry` vekili). Self-host'ta kendi adresiniz:
#   TELEMETRY_HOST=http://posthog:8000
TELEMETRY_HOST=https://eu.i.posthog.com

# PostHog'un statik varlık adresi. Self-host'ta çoğu zaman TELEMETRY_HOST ile
# aynı; bulutta ayrı alan adı. Boş bırakılırsa TELEMETRY_HOST kullanılıyor.
# TELEMETRY_ASSET_HOST=https://eu-assets.i.posthog.com

# "PostHog'da aç" bağlantılarının kökü — insanın tarayıcıda açtığı adres,
# vekil adresi değil.
TELEMETRY_UI_HOST=https://eu.posthog.com

# Dağıtım etiketi. Panolarda dev/stage/prod'u ayırmanın tek yolu.
TELEMETRY_ENVIRONMENT=dev

# Olaylar oturum açmış kullanıcıya BAĞLANSIN MI. Varsayılan kapalı: kapalıyken
# posthog-js'in rastgele tarayıcı kimliği kullanılıyor, yani "kaç tarayıcı"
# sorusu cevaplanıyor ama "hangi kullanıcı" cevaplanmıyor.
#
# Açarsanız TELEMETRY_IDENTITY_SALT ZORUNLU olur ve eksikse uygulama
# telemetriyi "yapılandırılmamış" sayar (vekil 503 + eksik değişken adı).
# Sessizce anonime düşmüyor — o, kimsenin vermediği bir karar olurdu.
TELEMETRY_IDENTIFY_USERS=false

# Keycloak `sub`'ının HMAC tuzu. Kuruluma özel, rastgele, ve gizli:
#   openssl rand -hex 32
# Ham `sub` gitmiyor; tuzlanmış özeti gidiyor. Tuz değişirse geçmiş
# kullanıcı sayımlarıyla bağ kopar.
# TELEMETRY_IDENTITY_SALT=
