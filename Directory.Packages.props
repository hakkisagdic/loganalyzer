<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Sürümler burada tek yerden yönetilir. Elle "latest" yazılmaz.
    Hedef çatı net10.0 (LTS). SDK: ~/.dotnet/sdk/10.0.302 (arm64).
    PATH'teki /usr/local/share/dotnet yalnızca SDK 8 ve 9 içeriyor — bkz. README.
  -->
  <ItemGroup Label="Depolama">
    <PackageVersion Include="ClickHouse.Driver" Version="1.3.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.1" />
    <!--
      Saf yönetilen zstd portu. Yerel kütüphane bağlamayan sürüm bilinçli tercih:
      konteyner imajına ek .so girmiyor ve arm64/x64 ayrımı yok.
    -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup Label="Kimlik">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Kontrol düzlemi">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Ingest">
    <!-- OTLP çözücü: yalnızca mesaj sınıfları üretilir (GrpcServices=None), gRPC yok. -->
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <!-- WAL segment CRC'si. -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <!--
      System.Text.Encoding.CodePages PAKETİ YOK: net10.0'da çatının içinde geliyor
      (NU1510). `CodePagesEncodingProvider` yine de elle kaydedilmek zorunda —
      kayıt edilmezse windows-1254 çalışma anında patlar (F1 §2.4).
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Parser motoru">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.ClickHouse" Version="4.14.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>

</Project>
