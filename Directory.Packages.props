<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Sürümler burada tek yerden yönetilir. Elle "latest" yazılmaz.
    Hedef çatı net10.0 (LTS). SDK: ~/.dotnet/sdk/10.0.302 (arm64).
    PATH'teki /usr/local/share/dotnet yalnızca SDK 8 ve 9 içeriyor — bkz. README.
  -->
  <ItemGroup Label="Depolama">
    <PackageVersion Include="ClickHouse.Driver" Version="1.3.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.3" />
    <!--
      Saf yönetilen zstd portu. Yerel kütüphane bağlamayan sürüm bilinçli tercih:
      konteyner imajına ek .so girmiyor ve arm64/x64 ayrımı yok.
    -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup Label="Kimlik">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <!--
      M13 — stdio kimliği. `bizigo mcp serve` bir belirteci ORTAMDAN alıyor ve
      doğrulaması gerekiyor; `AddJwtBearer` KULLANILAMIYOR çünkü ASP.NET
      paylaşılan çatısı `Bizigo.Cli`'ye inince `Program` çakışması doğuruyor
      (ölçüldü, gerekçe `Bizigo.Mcp.csproj`'da yazılı).

      Sürüm 8.19.2 SEÇİLMEDİ, ÖLÇÜLDÜ: `Microsoft.AspNetCore.Authentication.JwtBearer`
      10.0.11 zaten bu sürümü çözüyor (`Bizigo.Api/obj/project.assets.json`).
      Yani API'nin belirteci doğruladığı kütüphaneyle stdio'nun doğruladığı
      kütüphane AYNI sürüm — ayrı bir sürüm, iki yüzeyin aynı belirteç
      hakkında farklı karar vermesi demek olurdu.
    -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Kontrol düzlemi">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Ingest">
    <!-- OTLP çözücü: yalnızca mesaj sınıfları üretilir (GrpcServices=None), gRPC yok. -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <!-- WAL segment CRC'si. -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <!--
      System.Text.Encoding.CodePages PAKETİ YOK: net10.0'da çatının içinde geliyor
      (NU1510). `CodePagesEncodingProvider` yine de elle kaydedilmek zorunda —
      kayıt edilmezse windows-1254 çalışma anında patlar (F1 §2.4).
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!--
      `bizigo mcp serve` günlükleri STDERR'e yazıyor: stdio taşımasında stdout
      protokolün kendisi ve oraya düşen tek bir satır JSON-RPC akışını bozuyor.
      Konsol sağlayıcısı ASP.NET paylaşılan çatısında geliyor ama `Bizigo.Cli`
      bir konsol uygulaması ve o çatıyı BİLEREK taşımıyor
      (bkz. `Bizigo.Mcp.csproj`), dolayısıyla paket olarak gerekiyor.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Alarm ve bildirim">
    <!--
      Kanal göndericileri IHttpClientFactory üzerinden gidiyor: her gönderimde
      yeni HttpClient kurmak soket tükenmesi demek ve alarm yolu tam da en kötü
      anda, olay sağanağında yoğunlaşıyor.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Parser motoru">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />

    <!--
      Cihaz config toplama (T26). Ürünün cihazlara SSH ile bağlanan tek
      bağımlılığı; hangi derlemenin cihaza soket açabildiği `Bizigo.Devices`
      proje sınırında duruyor.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <!--
    MCP (M01). Resmî C# SDK'sı — Apache-2.0, Linux Foundation projesi, `net10.0`
    hedefi var. Elle yazmak yerine seçildi ve gerekçe K36'nın emsalinde:
    bağımlılık protokolü KONUŞMAK için, uyum kapısını KURMAK için değil. Kapı
    sunucunun ilan ettiği `tools/list` çıktısını okuyor, dolayısıyla SDK yanlış
    yaparsa da kırmızı yanıyor — güven SDK'ya değil ölçüme bağlı.

    `ModelContextProtocol` = barındırma + DI + stdio taşıması.
    `.AspNetCore`        = akışlanabilir HTTP taşıması.
    `.Core`              = protokol tipleri; ikisinin de bağımlılığı, ayrıca
                           YAZILI çünkü uyum kapısı doğrudan onu kullanıyor.

    Uyduğumuz revizyon `McpRevision.Supported` içinde sabit ve bekçisi var;
    sürüm burada, revizyon orada — ikisi farklı sorular.
  -->
  <ItemGroup Label="MCP">
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.ClickHouse" Version="4.14.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <!--
      Alarm zamanlayıcısının turu kontrol düzlemine yazıyor ve kabul kriterleri
      (bakım penceresinde tetiklenme yok, pencere bitince var) ancak gerçek bir
      DbContext üzerinde sınanabiliyor. Konteyner gerekmiyor.

      Önce SQLite denendi ve ÖLÇÜLEREK elendi: EF'in SQLite sağlayıcısı
      `DateTimeOffset` karşılaştırmasını SQL'e çeviremiyor ("The LINQ expression
      ... could not be translated") ve zamanlayıcının tek sorgusu tam olarak o —
      "vadesi gelmiş kurallar". Testi geçirmek için varlıkların zaman tipini
      değiştirmek, üretimi test sağlayıcısına uydurmak olurdu. InMemory sorguyu
      .NET semantiğiyle koşuyor; SQL doğruluğu zaten entegrasyon testinin işi.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />

    <!--
      MCP uyum kapısı (M01). İkisi de YALNIZCA test projesinde: ürün yüzeyine
      girmiyorlar, ve girmemeleri bilinçli.

      `JsonSchema.Net`: kapı, ilan edilen şemayı meta-şemaya karşı doğruluyor ve
      örnek çağrının çıktısını `outputSchema`'ya karşı sınıyor. MCP SDK'sı bunu
      kendi içinde de yapıyor olabilir — ama kapının SDK'nın doğruluğuna
      dayanması, ölçtüğü şeyi ölçen aracın kendisine sormak olurdu. Ağ
      kullanmıyor: 2020-12 meta-şeması pakete gömülü.

      `Microsoft.ML.Tokenizers` + `.Data.O200kBase`: araç şemalarının BAĞLAM
      MALİYETİ bir sayı olarak isteniyor (plan §9). Alternatif "≈4 karakter =
      1 belirteç" tahminiydi ve §6 tam olarak bunu yasaklıyor — ölçülmüş görünen
      bir tahmin, ölçmemekten kötü. `.Data.O200kBase` sözlüğü GÖMÜLÜ taşıyor,
      yani koşum ağ istemiyor.
    -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />

    <!--
      MCP'nin İKİNCİ taşıması (akışlanabilir HTTP) gerçek bir el sıkışmayla
      sınanıyor. Konteyner GEREKTİRMİYOR: `TestServer` süreç içinde koşuyor,
      soket açılmıyor. Bitti tanımının 1. maddesi "iki taşımada da çalışıyor"
      diyor ve onu ölçmeden yazmak, bu deponun yasakladığı türden bir iddia
      olurdu.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />

    <!--
      GEÇİŞLİ ÇİVİ, gerekçesi bir güvenlik uyarısı. `Microsoft.ML.Tokenizers`
      2.0.0 `Microsoft.Bcl.Memory` 9.0.4'ü çekiyor ve o sürümde bilinen bir
      YÜKSEK önem dereceli açık var (GHSA-73j8-2gch-69rq). Depoda
      `TreatWarningsAsErrors` açık olduğu için NU1903 derlemeyi kırıyor —
      yani kapı zaten çalıştı ve bu satır onun cevabı, susturucusu değil.

      `CentralPackageTransitivePinningEnabled` sayesinde burada bir sürüm
      yazmak geçişli bağımlılığı da yükseltiyor. 10.0.11 seçildi: deponun geri
      kalanı zaten 10.0.11 ailesinde.
    -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.11" />
  </ItemGroup>

</Project>
